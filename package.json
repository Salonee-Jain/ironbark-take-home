{
  "name": "ironbark-ridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Emissions, safety and data-quality intelligence for Ironbark Ridge Resources",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:check": "npm run check --workspace @ironbark/db",
    "db:migrate": "npm run migrate --workspace @ironbark/db --",
    "etl": "npm run start --workspace @ironbark/etl",
    "ai:classify": "npm run ai:classify --workspace @ironbark/etl --",
    "ai:report": "npm run ai:report --workspace @ironbark/api --",
    "writeup": "npm run writeup --workspace @ironbark/etl --",
    "api": "npm run dev --workspace @ironbark/api",
    "web": "npm run dev --workspace @ironbark/web"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
