# Copy to .env and fill in. Never commit .env.
# cp .env.example .env

# --- Database ---------------------------------------------------------------
# These three are consumed by docker-compose.yml when it creates the container.
POSTGRES_USER=ironbark
POSTGRES_PASSWORD=ironbark
POSTGRES_DB=ironbark

# Port 5433 on the host to avoid colliding with a local Postgres on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ironbark:ironbark@localhost:5433/ironbark

# --- API --------------------------------------------------------------------
# 4000 rather than 3000: a dev server on 3000 is near-universal, and the
# resulting collision is quiet — the port binds, but requests reach the other
# process, so the API looks broken rather than absent.
API_PORT=4000
API_HOST=127.0.0.1

# --- AI layer ---------------------------------------------------------------
# Optional. The classified incident findings are committed to
# data/ai/incident_findings.json, so the app runs fully without a key.
# A key is only needed to re-run classification (`npm run ai:classify`).
# Get one at https://console.anthropic.com/ — expected spend is under $1.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Authentication ---------------------------------------------------------
# Signs the session JWT carried in the httpOnly cookie. At least 32 random
# characters. Required in production; in development an ephemeral secret is
# generated per process if this is blank, which means sessions do not survive
# an API restart.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origins allowed to send credentialed requests. Defaults to the Vite dev
# server. Only needed if the frontend is served from somewhere else.
# CORS_ORIGINS=http://localhost:5173

# --- Frontend ---------------------------------------------------------------
# Left blank on purpose: the Vite dev server proxies /api and /health to the
# API, so the browser and the API share an origin and the strict session cookie
# is sent normally. Set this only when the frontend is deployed separately from
# the API, and set CORS_ORIGINS to match.
VITE_API_BASE_URL=
